# Set MOCK=true to run without a real Lightning backend (auto-settles invoices)
MOCK=false
PHOENIXD_URL=http://localhost:9740
PHOENIXD_PASSWORD=
# Required macaroon signing key (64 hex characters). Generate with: openssl rand -hex 32
ROOT_KEY=
PORT=3000

# Nostr announcement (optional; needed for L402 discovery via 402-mcp).
# Leave both empty until your server has a public HTTPS URL, or it will
# announce a service nobody can reach. Example relay: wss://relay.damus.io
PUBLIC_URL=
ANNOUNCE_RELAYS=
