{
  "name": "@forgesworn/toll-booth",
  "version": "6.0.1",
  "type": "module",
  "description": "Monetise any API with HTTP 402 payments. Payment-rail agnostic middleware for Express, Hono, Deno, Bun, and Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "provenance": true
  },
  "keywords": [
    "l402",
    "lightning",
    "paywall",
    "micropayments",
    "middleware",
    "cashu",
    "ecash",
    "nostr",
    "nwc",
    "bitcoin",
    "express",
    "hono",
    "deno",
    "bun",
    "cloudflare-workers",
    "serverless",
    "typescript",
    "macaroon",
    "http-402",
    "http-payment",
    "ietf-payment",
    "api-monetisation",
    "payment-gateway",
    "payment-authentication",
    "multi-rail",
    "ai-agents",
    "machine-payments",
    "api-monetization",
    "x402",
    "self-hosted",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/toll-booth.git"
  },
  "homepage": "https://github.com/forgesworn/toll-booth#readme",
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "bin": {
    "toll-booth": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./backends/phoenixd": {
      "import": "./dist/backends/phoenixd.js",
      "types": "./dist/backends/phoenixd.d.ts"
    },
    "./backends/lnd": {
      "import": "./dist/backends/lnd.js",
      "types": "./dist/backends/lnd.d.ts"
    },
    "./backends/cln": {
      "import": "./dist/backends/cln.js",
      "types": "./dist/backends/cln.d.ts"
    },
    "./backends/nwc": {
      "import": "./dist/backends/nwc.js",
      "types": "./dist/backends/nwc.d.ts"
    },
    "./backends/lnbits": {
      "import": "./dist/backends/lnbits.js",
      "types": "./dist/backends/lnbits.d.ts"
    },
    "./storage/sqlite": {
      "import": "./dist/storage/sqlite.js",
      "types": "./dist/storage/sqlite.d.ts"
    },
    "./storage/memory": {
      "import": "./dist/storage/memory.js",
      "types": "./dist/storage/memory.d.ts"
    },
    "./adapters/express": {
      "import": "./dist/adapters/express.js",
      "types": "./dist/adapters/express.d.ts"
    },
    "./adapters/web-standard": {
      "import": "./dist/adapters/web-standard.js",
      "types": "./dist/adapters/web-standard.d.ts"
    },
    "./hono": {
      "import": "./dist/adapters/hono.js",
      "types": "./dist/adapters/hono.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts.map",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:release": "npm run check:publish-dependencies && npm test",
    "check:publish-dependencies": "node scripts/check-publish-dependencies.mjs",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integration:ln": "bash scripts/test-integration.sh --ln-only",
    "test:integration:cashu": "bash scripts/test-integration.sh --cashu-only",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check:publish-dependencies && npm run build && npm test",
    "prepare": "patch-package"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.7.2",
    "@forgesworn/nwc-kit": "0.1.2",
    "better-sqlite3": "^13.0.2",
    "farrier-kit": "1.1.2",
    "macaroon": "^3.0.4",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "express": "^5.2.1",
    "hono": "^4.12.8",
    "nostr-tools": "^2.24.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
